{
  "manifest_version": 3,
  "name": "APOD - NASA Astronomy Picture of the Day",
  "description": "Transform your new tab with NASA's Astronomy Picture of the Day. Explore HD space wallpapers, nebulae, galaxies, and cosmic history.",
  "options_page": "popup.html",
  "short_name": "APOD New Tab",
  "version": "4.2.0",
  "background": { "service_worker": "background.bundle.js" },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon-34.png"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "host_permissions": ["https://api.nasa.gov/*"],
  "permissions": ["topSites", "storage", "favicon"]
}
